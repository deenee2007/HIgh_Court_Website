# Copy these into Render (Environment tab). Never commit real values to GitHub.
NODE_ENV=production
# MongoDB Atlas connection string (Atlas: Connect, Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Optional: database name (default gombe_high_court)
MONGODB_DB=gombe_high_court
# Cloudinary: Dashboard, API Environment variable
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# The public address of the site, without a trailing slash
SITE_URL=https://www.example.gov.ng
# Code needed once, to create the first super admin at /admin/setup
SETUP_TOKEN=choose-a-long-random-code
